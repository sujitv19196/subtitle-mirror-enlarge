{
  "name": "subtitle-mirror",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "submirror": "src/server/cli.ts"
  },
  "scripts": {
    "play": "bun src/server/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --minify src/server/cli.ts --outfile dist/submirror",
    "app:ui": "bun build app/ui/index.html --outdir app/dist-ui --minify",
    "app:stage": "bun scripts/stage-binaries.ts",
    "app:dev": "cd app && tauri dev",
    "app:build": "cd app && tauri build"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/cli": "2.12.6",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-shell": "2.6.0",
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
