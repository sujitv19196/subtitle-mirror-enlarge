{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Spawn and talk to the bundled sidecar; open a video with the file dialog.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/submirror-sidecar", "sidecar": true }]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
