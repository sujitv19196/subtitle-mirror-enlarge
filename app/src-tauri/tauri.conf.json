{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subtitle Mirror",
  "version": "../../package.json",
  "identifier": "io.github.sujitv19196.submirror",
  "build": {
    "frontendDist": "../dist-ui",
    "beforeDevCommand": "bun run app:ui",
    "beforeBuildCommand": "bun run app:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Subtitle Mirror",
        "width": 520,
        "height": 680,
        "minWidth": 420,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Utility",
    "shortDescription": "Mirror video subtitles to your phone in large type",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/submirror-sidecar"],
    "resources": ["resources/"],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
